# QUICKSILVER CRUCIBLE (水银坩埚) — Supabase Cloud Save Environment Configuration
# 若未配置以下变量，游戏将自动以 Local-First (Dexie.js IndexedDB + Loopback Cloud Gateway) 离线优先模式零报错运行。
# 配置真实 Supabase 实例后（执行 supabase/migrations/0001_initial_cloud_save.sql），将自动开启匿名鉴权、Magic Link/OAuth 无损转正与跨端云同步。

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
